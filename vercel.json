{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/clinic/", "permanent": false },
    { "source": "/clinic", "destination": "/clinic/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/clinic/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/clinic/images/:path*", "destination": "/images/:path*" },
    { "source": "/clinic/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/clinic/", "destination": "/index.html" },
    { "source": "/clinic/:path*", "destination": "/index.html" }
  ]
}
